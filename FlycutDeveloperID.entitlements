<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Entitlements for Soarcut's Developer ID (direct download / MDM) build.
	  Deliberately not sandboxed: Soarcut ships outside the Mac App Store, and
	  synthesizing paste needs Accessibility, which TCC grants per signed app.
	  Apple Events automation is kept for the legacy login-item fallback on
	  macOS 12 and earlier.
	-->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
